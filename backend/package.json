{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "./node_modules/.bin/vitest --run",
    "pretest": "cp prisma/schema.prisma prisma/schema.original.prisma && cp prisma/schema.test.prisma prisma/schema.prisma && prisma generate && prisma db push",
    "posttest": "mv prisma/schema.original.prisma prisma/schema.prisma",
    "test:watch": "./node_modules/.bin/vitest",
    "lint": "./node_modules/.bin/eslint .",
    "lint-fix": "./node_modules/.bin/eslint . --fix",
    "format": "prettier --write .",
    "dev": "tsx src/index.ts",
    "db:push": "prisma db push",
    "test:generate": "prisma generate --schema=./prisma/schema.test.prisma",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/client-secrets-manager": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^6.19.0",
    "@types/aws-lambda": "^8.10.142",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.6",
    "@vendia/serverless-express": "^4.12.6",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "binaryTargets": [
      "native",
      "linux-arm64-openssl-3.0.x"
    ]
  }
}
